# AK Ludo - Production Environment Variables Configuration Template
# Copy this file to .env and provide your production credentials

# --- Web & Server Host ---
PORT=3000
NODE_ENV=production

# --- Firebase Client Configuration (Web / Cross-Platform) ---
VITE_FIREBASE_API_KEY=AIzaSyExampleKeyForProductionUse
VITE_FIREBASE_AUTH_DOMAIN=ak-ludo-3d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ak-ludo-3d
VITE_FIREBASE_STORAGE_BUCKET=ak-ludo-3d.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=101150424964
VITE_FIREBASE_APP_ID=1:101150424964:web:ab934def8812c3
VITE_FIREBASE_DATABASE_URL=https://ak-ludo-3d-default-rtdb.firebaseio.com

# --- Google AdMob Production IDs ---
# Replace with your actual App ID and Ad Unit IDs from https://apps.admob.com
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
ADMOB_INTERSTITIAL_PRE_GAME_UNIT_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# --- WebRTC / Voice Chat Relay (Optional STUN / TURN servers) ---
RTC_STUN_SERVER=stun:stun.l.google.com:19302
RTC_TURN_SERVER=turn:turn.akludo.com:3478
RTC_TURN_USERNAME=akludo_guest
RTC_TURN_CREDENTIAL=secret_token_never_commit_plaintext
